# Data: downloaded by hand on each machine, never committed (size, licences, GDPR)
data/
*.zip
*.nii
*.nii.gz
*.npz
# ...except the predicted label maps of the test sets (model output, small)
!outputs/predictions*/**/*.nii.gz

# Model weights: only the final weights-only file is committed (via Git LFS, see
# .gitattributes); resume checkpoints (819 MB, optimizer state) stay local
*.pt
*.pth
*.ckpt
!lumbar/weights/lumbar_vertebrae_resenc_unet*.pt
runs/
checkpoints/

# Report build by-products
report/*.log
report/*.aux
report/*.out
report/*_page*.png

# Python
.venv/
.venv_inference/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.ipynb_checkpoints/

# OS and editors
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Claude Code machine-local settings
.claude/settings.local.json
